# Backend Environment Configuration
# Render provides PORT automatically. Use 5000 for local development.
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
# MongoDB Atlas Connection String (replace with your production database credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/banner_app?retryWrites=true&w=majority
# Strong secret for signing JWT auth tokens
JWT_SECRET=your_super_strong_production_jwt_secret_change_me
JWT_EXPIRES_IN=7d
# Allowed client CORS origins (comma-separated or * for mobile/all)
CLIENT_URL=*
# Optional first super-admin bootstrap credentials
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password
