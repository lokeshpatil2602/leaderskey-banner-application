# Frontend Mobile Environment Configuration
# Local development for Expo Go on a physical phone.
# Use the computer's LAN IPv4 address, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.39:5000/api

# For an Android emulator, use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Production:
# EXPO_PUBLIC_API_URL=https://your-render-service.onrender.com/api
